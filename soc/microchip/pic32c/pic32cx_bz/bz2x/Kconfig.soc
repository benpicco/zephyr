config SOC_FAMILY_MICROCHIP_PIC32CX_BZ2
	bool

config SOC_FAMILY
	default "microchip_pic32cx_bz2" if SOC_FAMILY_MICROCHIP_PIC32CX_BZ2

config SOC_SERIES_REVISION_N
	bool
	depends on SOC_FAMILY_MICROCHIP_PIC32CX_BZ2

config SOC_SERIES_REVISION
	string
	default "n" if SOC_SERIES_REVISION_N
	default ""
	depends on SOC_FAMILY_MICROCHIP_PIC32CX_BZ2

config SOC_SERIES_PIC32CX_BZ24
	bool
	select SOC_FAMILY_MICROCHIP_PIC32CX_BZ2
	help
	  Enable support for Microchip PIC32CX_BZ2 Cortex-M4F microcontrollers.

config SOC_SERIES_PIC32CX_BZ25
	bool
	select SOC_FAMILY_MICROCHIP_PIC32CX_BZ2
	help
	  Enable support for Microchip PIC32CX_BZ2 Cortex-M4F microcontrollers.

config SOC_SERIES
	default "bz24" if SOC_SERIES_PIC32CX_BZ24
	default "bz25" if SOC_SERIES_PIC32CX_BZ25

config SOC_PIC32CX1012BZ24032
	bool
	select SOC_SERIES_PIC32CX_BZ24

config SOC_PIC32CX1012BZ25048
	bool
	select SOC_SERIES_PIC32CX_BZ25

config SOC
	default "pic32cx1012bz24032" if SOC_PIC32CX1012BZ24032
	default "pic32cx1012bz25048" if SOC_PIC32CX1012BZ25048

config HPA_SUPPORTED
	bool
